generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Audit {
  id          String   @id @default(uuid())
  publicId    String   @unique
  toolsData   Json
  savingsData Json
  aiSummary   String?
  
  // Lead info
  email       String
  companyName String?
  role        String?
  teamSize    String?

  createdAt   DateTime @default(now())
}
